# ezBookkeeping – copia a .env y ajusta los valores.
# Docker Compose carga este archivo como referencia; usa .env para tus datos reales.

# ----- Usuario inicial (solo backend, primera puesta en marcha)
# Si los tres primeros están definidos, se crea un usuario al arrancar (si aún no existe).
# Moneda: ISO 4217 de 3 letras, p. ej. COP (peso colombiano), CLP (peso chileno), USD, EUR.
EBK_INIT_ADMIN_USERNAME=
EBK_INIT_ADMIN_PASSWORD=
EBK_INIT_ADMIN_EMAIL=
EBK_INIT_ADMIN_NICKNAME=
EBK_INIT_ADMIN_DEFAULT_CURRENCY=COP

# ----- Opcional: ruta del archivo de configuración dentro del contenedor
# EBK_CONF_PATH=/ezbookkeeping/conf/ezbookkeeping.ini
